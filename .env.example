# ---- OpenAI ----
OPENAI_API_KEY=
# Optional, defaults to gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# ---- Freshness ----
# Only include items published within this many days. Default: 7.
FRESHNESS_DAYS=7

# ---- Air Quality ----
# No token needed — the report pulls live official data from the Ministry of
# Environmental Protection's national monitoring network (air.sviva.gov.il)
# via its public API. See README "נתוני איכות אוויר" for details.
# Run `npm run test-air-quality` to check connectivity without generating a report.

# ---- Gmail SMTP ----
# For Gmail use an "App Password" (not your normal password):
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=your-address@gmail.com
EMAIL_TO=lirankor@gmail.com

# ---- Safety switch ----
# Emails are NEVER sent unless this is exactly "true".
SEND_EMAIL=false
